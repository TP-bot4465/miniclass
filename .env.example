# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# Storage Paths (stored outside public web root per NFR-08)
DATA_DIR=./data
DB_PATH=./data/miniclass.sqlite
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups

# Security & Session
SESSION_SECRET=change-this-secret-in-production-miniclass-2026
SESSION_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# File Upload Default Limits (Configurable dynamically by Admin via ADM-03)
MAX_SUBMISSION_SIZE_MB=10
MAX_ATTACHMENT_SIZE_MB=20
MAX_IMAGE_SIZE_MB=5
MAX_ATTACHMENTS_PER_SESSION=10
ALLOWED_SUBMISSION_EXTENSIONS=doc,docx,pdf,txt,md,py,ipynb,html,css,js,java,c,cpp,zip,rar,xls,xlsx,ppt,pptx,png,jpg

# SMTP / Email Configuration (NOT-04)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@miniclass.local
SMTP_PASS=your-app-password
SMTP_FROM="MiniClass <noreply@miniclass.local>"
